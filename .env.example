APP_ENV=development
API_PORT=8100
MIAOBI_NAMESPACE=chuanshenmiaobi_dev

# 可复用既有中间件，但必须使用独立数据库或前缀。
DATABASE_URL=postgresql+psycopg://user:password@host:5432/chuanshenmiaobi
REDIS_URL=redis://host:6379/8
RABBITMQ_URL=amqp://user:password@host:5672/chuanshenmiaobi
MINIO_ENDPOINT=host:9000
MINIO_BUCKET=chuanshenmiaobi-dev
OPENSEARCH_INDEX_PREFIX=chuanshenmiaobi-dev
QDRANT_COLLECTION_PREFIX=chuanshenmiaobi-dev
FALKORDB_GRAPH_PREFIX=chuanshenmiaobi-dev

# OpenAI-compatible model. Keep the key only in the ignored .env or a secret manager.
MIAOBI_LLM_BASE_URL=http://model-host:port/v1
MIAOBI_LLM_MODEL=model-name
MIAOBI_LLM_API_KEY=
MIAOBI_LLM_TIMEOUT_SECONDS=120
MIAOBI_LLM_MAX_TOKENS=4096
MIAOBI_LLM_ENABLE_THINKING=false

# MVP persistence. PostgreSQL can replace SQLite without changing the API model.
MIAOBI_DATABASE_URL=sqlite:///./.data/miaobi.db
MIAOBI_STORAGE_ROOT=./.data/uploads
